<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Left Vertical Stem (Deep Indigo) -->
    <path
        android:pathData="M33,26 L46,26 L46,78 Q39.5,75 33,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33"
                android:startY="26"
                android:endX="33"
                android:endY="82"
                android:startColor="#4338CA"
                android:endColor="#6366F1" />
        </aapt:attr>
    </path>

    <!-- 2. Right Vertical Stem (Indigo to Midnight Violet) -->
    <path
        android:pathData="M62,26 L75,26 L75,82 Q68.5,75 62,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="62"
                android:startY="26"
                android:endX="62"
                android:endY="82"
                android:startColor="#4F46E5"
                android:endColor="#3730A3" />
        </aapt:attr>
    </path>

    <!-- 3. Ambient Shadow Under Diagonal Fold -->
    <path
        android:pathData="M33,26 L46,26 L46,58 L33,46 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33"
                android:startY="26"
                android:endX="46"
                android:endY="58"
                android:startColor="#66000000"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- 4. Diagonal Ribbon Fold (Cyber Neon Cyan to Electric Indigo) -->
    <path
        android:pathData="M33,26 L46,26 L75,78 Q68.5,75 62,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33"
                android:startY="26"
                android:endX="75"
                android:endY="82"
                android:startColor="#00E5FF"
                android:endColor="#6366F1" />
        </aapt:attr>
    </path>

    <!-- 5. Top Specular Highlight Edge -->
    <path
        android:pathData="M33,26 L46,26 L46,28 L33,28 Z"
        android:fillColor="#80FFFFFF" />

    <!-- 6. Pulsing Neon Cyan Broadcast Dot -->
    <path
        android:pathData="M81,32 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"
        android:fillColor="#00E5FF" />

</vector>